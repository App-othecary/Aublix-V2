# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client-side public keys)
# For this Vite preview, set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
# When exporting to Next.js App Router, rename to NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in .env.local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
